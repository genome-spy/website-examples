{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/app/dist/schema.json",

  "assembly": "hg19",

  "description": [
    "TCGA-BRCA: CNVs and Mutations",
    "The results shown here are in whole or part based upon data generated by the TCGA Research Network: https://www.cancer.gov/tcga."
  ],

  "resolve": { "scale": { "x": "shared" } },

  "spacing": 7,

  "vconcat": [
    {
      "name": "samples",
      "title": "Samples",
      "stickySummaries": true,
      "samples": {
        "identity": {
          "data": {
            "url": "samples.tsv"
          },
          "idField": "sample"
        },
        "labelLength": 100
      },

      "sampleLayout": {
        "sampleHeight": 20,
        "sampleSpacingFactor": 0.05
      },

      "metadata": {
        "sources": [
          {
            "id": "clinical",
            "name": "Clinical metadata",
            "description": "Sample annotations loaded from samples.tsv.",
            "initialLoad": "*",
            "backend": {
              "backend": "data",
              "data": {
                "url": "samples.tsv"
              },
              "sampleIdField": "sample"
            },
            "attributes": {
              "er_status": {
                "title": "ER status",
                "type": "nominal",
                "scale": {
                  "domain": ["Negative", "Positive", "Indeterminate"],
                  "scheme": "set1"
                }
              },
              "pr_status": {
                "title": "PR status",
                "type": "nominal",
                "scale": {
                  "domain": ["Negative", "Positive", "Indeterminate"],
                  "scheme": "set1"
                }
              },
              "her2_status": {
                "title": "HER2 status",
                "type": "nominal",
                "scale": {
                  "domain": [
                    "Negative",
                    "Positive",
                    "Indeterminate",
                    "Equivocal"
                  ],
                  "scheme": "set1"
                }
              },
              "tumor_stage": {
                "title": "Tumor stage",
                "type": "ordinal"
              },
              "histological_type": {
                "title": "Histological type",
                "type": "nominal"
              },
              "age": {
                "title": "Age",
                "type": "quantitative"
              },
              "gender": {
                "title": "Gender",
                "type": "nominal"
              },
              "race": {
                "title": "Race",
                "type": "nominal"
              },
              "PFI": {
                "title": "PFI",
                "type": "nominal"
              },
              "PFI.time": {
                "title": "PFI time",
                "type": "quantitative",
                "scale": {
                  "type": "sqrt"
                }
              },
              "breaks": {
                "title": "Breaks",
                "type": "quantitative",
                "scale": {
                  "scheme": "lightorange"
                },
                "barScale": {},
                "width": 20
              }
            }
          }
        ]
      },

      "spec": {
        "name": "genomic-data",
        "title": "Genomic data",

        "params": [
          {
            "name": "brush",
            "select": {
              "type": "interval",
              "encodings": ["x"],
              "zoom": "wheel[event.shiftKey]",
              "mark": {
                "fill": "#a0ff00",
                "fillOpacity": 0.05,
                "stroke": "black",
                "strokeOpacity": 0.8,
                "measure": "inside",
                "shadowOpacity": 1.0,
                "shadowColor": "white",
                "shadowBlur": 25
              }
            }
          }
        ],

        "resolve": {
          "scale": { "color": "independent" }
        },

        "layer": [
          {
            "name": "cnv",
            "title": "Copy number variation",

            "configurableVisibility": true,

            "data": {
              "url": "segments.tsv"
            },

            "mark": {
              "type": "rect"
            },

            "encoding": {
              "x": {
                "chrom": "Chromosome",
                "pos": "Start",
                "type": "locus",
                "axis": {
                  "orient": "bottom",
                  "grid": false,
                  "chromGrid": true,
                  "chromGridDash": [3, 3],
                  "chromGridColor": "lightgray"
                }
              },
              "x2": { "chrom": "Chromosome", "pos": "End" },
              "sample": { "field": "Sample" },
              "color": {
                "field": "Segment_Mean",
                "type": "quantitative",
                "scale": {
                  "domain": [-1.5, 0, 1.5],
                  "range": ["#0050f8", "#f6f6f6", "#ff3000"]
                }
              }
            },

            "aggregateSamples": [
              {
                "name": "cnv-summary",
                "title": "G score (summarized copy-numbers)",
                "height": 50,
                "view": { "stroke": "lightgray" },
                "padding": { "bottom": 4 },
                "transform": [],
                "encoding": {
                  "y": {
                    "field": "coverage",
                    "type": "quantitative",
                    "axis": null,
                    "scale": { "domain": [-1, 0, 1] }
                  }
                },
                "layer": [
                  {
                    "name": "amplification",
                    "transform": [
                      { "type": "filter", "expr": "datum.Segment_Mean > 0" },
                      {
                        "type": "coverage",
                        "chrom": "Chromosome",
                        "start": "Start",
                        "end": "End",
                        "weight": "Segment_Mean"
                      },
                      {
                        "type": "formula",
                        "expr": "datum.coverage / sampleCount",
                        "as": "coverage"
                      }
                    ],
                    "mark": {
                      "type": "rect",
                      "minOpacity": 1,
                      "minWidth": 0,
                      "tooltip": null
                    },
                    "encoding": {
                      "color": { "value": "#e45756" }
                    }
                  },
                  {
                    "name": "deletion",
                    "transform": [
                      { "type": "filter", "expr": "datum.Segment_Mean < 0" },
                      {
                        "type": "coverage",
                        "chrom": "Chromosome",
                        "start": "Start",
                        "end": "End",
                        "weight": "Segment_Mean"
                      },
                      {
                        "type": "formula",
                        "expr": "datum.coverage / sampleCount",
                        "as": "coverage"
                      }
                    ],
                    "mark": {
                      "type": "rect",
                      "minOpacity": 1,
                      "minWidth": 0,
                      "tooltip": null
                    },
                    "encoding": {
                      "color": { "value": "#4c78a8" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "name": "mutations",
            "title": "Point mutations and indels",

            "configurableVisibility": true,

            "data": {
              "url": "mutations.tsv"
            },

            "transform": [
              {
                "type": "formula",
                "expr": "datum.Chromosome == 'MT' ? 'M' : datum.Chromosome",
                "as": "Chromosome"
              }
            ],

            "mark": {
              "type": "point",
              "stroke": "black",
              "strokeWidth": 1,
              "strokeOpacity": 0.7,
              "fillGradientStrength": 0.3
            },

            "encoding": {
              "sample": { "field": "Sample" },
              "x": {
                "chrom": "Chromosome",
                "pos": "Start_Position",
                "type": "locus"
              },
              "color": {
                "field": "Variant_Classification",
                "type": "nominal",
                "scale": {
                  "domain": [
                    "Nonsense_Mutation",
                    "Nonstop_Mutation",
                    "Frame_Shift_Ins",
                    "Frame_Shift_Del",
                    "Missense",
                    "Missense_Mutation",
                    "Splice_Site_Del",
                    "Splice_Site_Ins",
                    "Splice_Site_SNP",
                    "In_Frame_Del",
                    "In_Frame_Ins",
                    "Silent"
                  ],
                  "range": [
                    "#e31a1c",
                    "#ff7f00",
                    "#6a3d9a",
                    "#6a3d9a",
                    "#1f78b4",
                    "#1f78b4",
                    "#b2df8a",
                    "#b2df8a",
                    "#b2df8a",
                    "#cab2d6",
                    "#cab2d6",
                    "#33a02c"
                  ]
                }
              },
              "size": {
                "field": "CADD_PHRED",
                "type": "quantitative",
                "scale": {
                  "domain": [0, 70],
                  "range": [
                    { "expr": "0" },
                    {
                      "expr": "pow(clamp(height * 0.65, 2, 18), 2)"
                    }
                  ]
                }
              },
              "semanticScore": {
                "field": "CADD_PHRED"
              }
            }
          }
        ]
      }
    }
  ]
}
