{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",

  "name": "mm10-cytobands",
  "title": {
    "text": "Chromosome Ideogram",
    "style": "track-title"
  },

  "description": "Mouse mm10 chromosome ideogram based on UCSC cytoBandIdeo annotations. Cytoband names are searchable using chromosome-prefixed names such as '1qA1'.",

  "view": {
    "stroke": "black"
  },

  "height": 24,

  "data": {
    "url": "https://data.genomespy.app/datasets/encode-mouse-fetal-chromatin-mm10/v5/external-data/cytobands.tsv.gz",
    "format": {
      "type": "tsv",
      "columns": ["chrom", "chromStart", "chromEnd", "name", "gieStain"]
    }
  },

  "transform": [
    {
      "type": "filter",
      "expr": "test(/^chr([1-9]|1[0-9]|X|Y)$/, datum.chrom)"
    },
    {
      "type": "regexExtract",
      "field": "chrom",
      "regex": "^chr(.*)$",
      "as": "chromNumber"
    },
    {
      "type": "formula",
      "expr": "datum.chromNumber + datum.name",
      "as": "fullName"
    }
  ],

  "encoding": {
    "x": {
      "chrom": "chrom",
      "pos": "chromStart",
      "type": "locus",
      "axis": null
    },
    "x2": {
      "chrom": "chrom",
      "pos": "chromEnd"
    }
  },

  "resolve": {
    "scale": {
      "color": "independent"
    }
  },

  "layer": [
    {
      "name": "cytobands-rects",
      "title": "Cytoband",
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "gieStain",
          "type": "nominal",
          "scale": {
            "domain": [
              "gneg",
              "gpos25",
              "gpos33",
              "gpos50",
              "gpos66",
              "gpos75",
              "gpos100",
              "acen",
              "stalk",
              "gvar"
            ],
            "range": [
              "#f0f0f0",
              "#e0e0e0",
              "#dadada",
              "#d0d0d0",
              "#c8c8c8",
              "#c0c0c0",
              "#a0a0a0",
              "#cc4444",
              "#338833",
              "#000000"
            ]
          }
        },
        "search": {
          "field": "fullName",
          "description": "Combined chromosome number and chromosomal band. Useful for locus search, e.g. '1qA1'."
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "paddingX": 4,
        "tooltip": null
      },
      "encoding": {
        "color": {
          "field": "gieStain",
          "type": "nominal",
          "scale": {
            "domain": [
              "gneg",
              "gpos25",
              "gpos33",
              "gpos50",
              "gpos66",
              "gpos75",
              "gpos100",
              "acen",
              "stalk",
              "gvar"
            ],
            "range": [
              "black",
              "black",
              "black",
              "black",
              "black",
              "black",
              "black",
              "black",
              "white",
              "white"
            ]
          }
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "type": "filter",
          "expr": "datum.chromStart == 0 && datum.chrom != 'chr1'"
        }
      ],
      "encoding": {
        "x2": null
      },
      "mark": {
        "type": "rule",
        "color": "#a0a0a0",
        "strokeDash": [3, 3],
        "strokeDashOffset": 2
      }
    }
  ]
}
