{
  "$schema": "https://cdn.jsdelivr.net/npm/@genome-spy/core/dist/schema.json",
  "name": "chromatin-signal",
  "height": 16,
  "view": {
    "fill": "black",
    "fillOpacity": 0.025
  },
  "data": {
    "lazy": {
      "type": "figwig",
      "url": "https://data.genomespy.app/datasets/encode-mouse-fetal-chromatin-mm10/v5/chromatin.fw",
      "tracks": {
        "expr": "visibleSamples"
      },
      "mode": "fast",
      "pixelsPerBin": 1
    }
  },
  "transform": [
    {
      "type": "filter",
      "expr": "isValid(datum.score) && datum.score >= 0"
    }
  ],
  "mark": {
    "type": "rect",
    "color": "#4c78a8",
    "minHeight": 0.5,
    "minOpacity": {
      "expr": "clamp((height - 4) / 8, 0, 1)"
    }
  },
  "encoding": {
    "sample": {
      "field": "sampleId"
    },
    "x": {
      "chrom": "chrom",
      "pos": "start",
      "type": "locus",
      "axis": {
        "grid": true,
        "gridColor": "#eeeeee",
        "chromGrid": true
      }
    },
    "x2": {
      "chrom": "chrom",
      "pos": "end"
    },
    "y": {
      "field": "score",
      "type": "quantitative",
      "scale": {
        "zero": true
      },
      "axis": {
        "title": "Fold change",
        "titleFit": "range"
      }
    },
    "tooltip": [
      {
        "field": "sampleId",
        "title": "Track"
      },
      {
        "field": "score",
        "title": "Fold change over control",
        "format": ".4g"
      }
    ]
  }
}
