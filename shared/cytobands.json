{
  "$schema": "https://unpkg.com/@genome-spy/core/dist/schema.json",

  "name": "ideogram-track",
  "title": {
    "text": "Chromosome Ideogram",
    "style": "track-title",
    "reserve": false
  },

  "description": "Chromosome ideogram with cytoband annotations.",

  "visible": true,

  "view": {
    "stroke": "black"
  },

  "height": 24,
  "data": { "url": "cytobands.tsv" },
  "transform": [
    { "type": "filter", "expr": "!test(/_/, datum.chrom)" },
    {
      "type": "regexExtract",
      "field": "chrom",
      "regex": "^chr(.*)$",
      "as": "chromNumber"
    },
    {
      "type": "formula",
      "expr": "datum.chromNumber + datum.name",
      "as": "fullName"
    }
  ],
  "encoding": {
    "x": {
      "chrom": "chrom",
      "pos": "chromStart",
      "type": "locus",
      "axis": null
    },
    "x2": { "chrom": "chrom", "pos": "chromEnd" }
  },
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "layer": [
    {
      "name": "cytobands-rects",
      "title": "Cytoband",
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "gieStain",
          "type": "nominal",
          "scale": {
            "domain": [
              "gneg",
              "gpos25",
              "gpos50",
              "gpos75",
              "gpos100",
              "acen",
              "stalk",
              "gvar"
            ],
            "range": [
              "#f0f0f0",
              "#e0e0e0",
              "#d0d0d0",
              "#c0c0c0",
              "#a0a0a0",
              "#cc4444",
              "#338833",
              "#000000"
            ]
          },
          "legend": null
        },
        "search": {
          "field": "fullName",
          "description": "Combined chromosome number + chromosomal band. Useful for locus search, e.g. '1p36.33'."
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "paddingX": 4,
        "tooltip": null
      },
      "encoding": {
        "color": {
          "field": "gieStain",
          "type": "nominal",
          "scale": {
            "domain": [
              "gneg",
              "gpos25",
              "gpos50",
              "gpos75",
              "gpos100",
              "acen",
              "stalk",
              "gvar"
            ],
            "range": [
              "black",
              "black",
              "black",
              "black",
              "black",
              "black",
              "white",
              "white"
            ]
          },
          "legend": null
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "type": "filter",
          "expr": "datum.chromStart == 0 && datum.chrom != 'chr1'"
        }
      ],
      "encoding": {
        "x2": null
      },
      "mark": {
        "type": "rule",
        "color": "#a0a0a0",
        "strokeDash": [3, 3],
        "strokeDashOffset": 2
      }
    }
  ]
}
